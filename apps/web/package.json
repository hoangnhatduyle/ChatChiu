    "@dnd-kit/core": "^6.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@supabase/auth-js": "^2.119.0",
    "@supabase/realtime-js": "^2.119.0",
    "@tanstack/query-async-storage-persister": "^5.108.0",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-query-persist-client": "^5.108.0",
