{
  "name": "@chatchiu/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:contrast && tsc -b && vite build",
    "check:contrast": "node scripts/check-contrast.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:app": "E2E_SUITE=app playwright test --project=tablet --project=phone",
    "test:e2e:ui": "E2E_SUITE=ui playwright test --project=ui"
  },
  "dependencies": {
