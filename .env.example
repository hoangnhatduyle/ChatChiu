# Copy to .env.local for local dev. Never commit real secrets; only this file is tracked.
# Server variable names match the old app (Inventory_Tracking_App/.env.example) so the same values
# can be set on the new Vercel project. Browser variables move from NG_APP_* to VITE_* (Vite only
# exposes VITE_-prefixed variables to client code).

# ---- Browser (public, bundled into the web app) ----
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key
# Empty = same origin (/api/*). Set to http://localhost:3000 when running `vercel dev` separately.
VITE_API_BASE_URL=
# Must equal VAPID_PUBLIC_KEY below. (The old app hard-coded this in environment.prod.ts.)
VITE_VAPID_PUBLIC_KEY=
# Optional error tracking; blank disables it.
VITE_SENTRY_DSN=
VITE_ENVIRONMENT_NAME=development

# ---- Server only (Vercel env, never shipped to the browser) ----
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Listed in the old app's .env.example; not read by the current API code.
SUPABASE_JWT_SECRET=your-jwt-secret

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini

# Optional monthly per-user AI quotas (defaults applied if unset)
AI_QUOTA_EXPIRATION_PER_MONTH=1000
AI_QUOTA_RECEIPT_PER_MONTH=100

# CORS: comma-separated origins allowed to call /api/*
API_ALLOWED_ORIGINS=http://localhost:5173,https://your-new-project.vercel.app

# ---- Web Push ----
# Generate once: npx web-push generate-vapid-keys (the old project's keys can be reused at cutover)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Protects /api/cron/check-expirations. The cron itself stays disabled until cutover.
CRON_SECRET=generate-a-long-random-string

# ---- Optional cost guardrail (old app; not read by the current API code) ----
OPENAI_MONTHLY_BUDGET_USD=50
